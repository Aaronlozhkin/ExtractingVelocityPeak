        yl(2) = yl(2)+yl(2)*.05;
        ylim(yl);
        xlabel('Time (s)', fs, fs_label);
        ylabel([labels(figcont),'(CMs)'], fs, fs_label);

    end
    
subplot(k,1,num_artery+2)
    plot(tRRi,1000./RRi*60,'r', lw, lw_thick);
