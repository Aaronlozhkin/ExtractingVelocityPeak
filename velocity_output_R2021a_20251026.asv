    yl = ylim;
    yl(1) = yl(1)-yl(2)*.05;
    yl(2) = yl(2)+yl(2)*.05;
    ylim(yl);
    ylabel('etCO2 (mmHg)', fs, fs_label);
    
subplot(k,1,num_artery+4)
    yyaxis left
    plot(tRRi,MBP./MBV);
    axis tight
    ylabel('CVR (mmHg/(cm/s))', fs, fs_label);
    if(exist('angle_deg'))
        yyaxis right
        plot(t_before,angle_deg)
        ylabel('Tild (deg)', fs, fs_label);
    end
